# ============================================================
# Legal Metrology Mobile App - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# For local development, replace YOUR_LOCAL_IP with your
# machine's LAN IP address (not "localhost" — physical devices
# cannot reach localhost on your dev machine).
#
# Find your IP:
#   Windows: ipconfig (look for IPv4 Address)
#   macOS/Linux: ifconfig | grep inet
# ============================================================

# Backend API base URL
# Local dev example:
EXPO_PUBLIC_API_URL=http://192.168.1.100:5000/api
# Production example:
# EXPO_PUBLIC_API_URL=https://your-domain.com/api

# App metadata (optional)
EXPO_PUBLIC_APP_NAME=Legal Metrology Gov
EXPO_PUBLIC_APP_ENV=development
